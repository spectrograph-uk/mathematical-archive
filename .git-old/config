[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "github"]
	url = https://github.com/spectrograph-uk/mathematical-archive.git
	fetch = +refs/heads/*:refs/remotes/github/*
[branch "master"]
	remote = github
	merge = refs/heads/master
[remote "server"]
	url = moody@spectrograph.uk:git.git
	fetch = +refs/heads/*:refs/remotes/server/*
